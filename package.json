{
  "name": "imagequeue",
  "version": "0.1.0",
  "packageManager": "npm@12.2.0",
  "description": "Elaborate one idea into varied, concrete prompts, send them to several image models at once, and compare the results side by side.",
  "main": "./out/main/index.js",
  "author": {
    "name": "Yoshinao Inoguchi",
    "email": "yoshinao@inoguchi.com"
  },
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/nao7sep/imagequeue"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck:node && npm run typecheck:web && electron-vite build",
    "dist": "npm run build && npm run prepare:electron && electron-builder --publish never",
    "prepare:electron": "node node_modules/electron/install.js",
    "postinstall": "node scripts/fix-node-pty-helper-perms.js",
    "typecheck:node": "tsc --noEmit --composite false -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit --composite false -p tsconfig.web.json",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web && npm run typecheck:test",
    "test": "npm run typecheck && vitest run",
    "test:full": "npm test && npm run build && vitest run --config vitest.live.config.ts",
    "check:release-version": "node scripts/check-release-version.js",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@google/genai": "^2.30.0",
    "koffi": "^3.3.3",
    "nanoid": "^6.0.2",
    "node-pty": "^1.1.0",
    "openai": "^7.41.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@babel/parser": "^8.0.7",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "@google/genai@2.30.0": false,
    "electron-winstaller@5.4.0": true,
    "fsevents@2.3.3": false,
    "node-pty@1.1.0": true,
    "protobufjs@7.6.6": false,
    "koffi@3.3.3": false
  }
}
