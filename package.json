{
  "name": "imagequeue",
  "version": "0.1.0",
  "packageManager": "npm@12.0.2",
  "description": "Elaborate one idea into varied, concrete prompts, send them to several image models at once, and compare the results side by side.",
  "main": "./out/main/index.js",
  "author": {
    "name": "Yoshinao Inoguchi",
    "email": "yoshinao@inoguchi.com"
  },
  "license": "GPL-3.0-or-later",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck:node && npm run typecheck:web && electron-vite build",
    "dist": "npm run build && npm run prepare:electron && electron-builder --publish never",
    "prepare:electron": "node node_modules/electron/install.js",
    "preview": "electron-vite preview",
    "build:unpack": "npm run build && npm run prepare:electron && electron-builder --dir",
    "build:mac": "npm run build && npm run prepare:electron && electron-builder --mac",
    "build:win": "npm run build && npm run prepare:electron && electron-builder --win",
    "postinstall": "node scripts/fix-node-pty-helper-perms.js",
    "typecheck:node": "tsc --noEmit --composite false -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit --composite false -p tsconfig.web.json",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web && npm run typecheck:test",
    "test": "npm run typecheck && vitest run",
    "test:full": "npm test && npm run build && vitest run --config vitest.live.config.ts",
    "check:release-version": "node scripts/check-release-version.js",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@google/genai": "^2.27.0",
    "nanoid": "^6.0.2",
    "node-pty": "^1.1.0",
    "openai": "^7.30.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "semver": "7.8.5"
  },
  "devDependencies": {
    "@babel/parser": "^8.0.6",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/semver": "7.8.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^5.0.3",
    "electron": "^44.2.0",
    "electron-builder": "^26.17.0",
    "electron-vite": "^5.0.0",
    "jsdom": "^30.1.2",
    "typescript": "^7.0.2",
    "vite": "^7.3.7",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "@google/genai@2.27.0": false,
    "electron-winstaller@5.4.0": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": false,
    "node-pty@1.1.0": true,
    "protobufjs@7.6.5": false
  }
}
